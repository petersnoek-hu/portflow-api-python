# Kopieer dit bestand naar .env en vul jouw waarden in.
# Uitleg per variabele: zie README.md, sectie "Configuratie (.env)".

# Bearer token voor de Portflow API. Mag leeg blijven: portflow.py vraagt dan om een
# nieuw token (via een browservenster of plakken) en slaat het hier op.
PORTFLOW_BEARER_TOKEN=

# Eerste en laatste dag van het semester (YYYY-MM-DD).
PORTFLOW_SEMESTER_START=2026-09-01
PORTFLOW_SEMESTER_END=2027-01-31

# ID van je eigen portfolio, te vinden in de URL als je je eigen portfolio opent:
# https://portfolio.drieam.app/portfolio/<ID>/...
PORTFLOW_OWN_PORTFOLIO_ID=

# Optioneel: komma-gescheiden namen van beoordelaars van wie beoordelingen worden weggelaten.
# Zonder deze regel geldt de standaardnaam in portflow.py.
# PORTFLOW_EXCLUDED_REVIEWERS=Voornaam Achternaam, Andere Naam

# Optioneel, alleen voor export_single_student.py --students-source section (standaard 72086).
# PORTFLOW_SECTION_ID=72086

# Studentenlijsten. Alleen "name" is verplicht; {"separator": true} geeft een scheidingslijn in de tabel.
# Overige velden: start_date ("YYYY-MM-DD" of null), semester, tribe, gilde, coach, gildemeester,
# resultaat ("geslaagd" of "gezakt").
PORTFLOW_COACH_STUDENTS_JSON=[
    {"name": "Voorbeeld Student", "start_date": null,         "semester": "3", "tribe": "Tribe A", "gilde": "FE", "coach": "Jouw Naam"},
    {"name": "Tweede Student",    "start_date": "2026-10-01", "semester": "4", "tribe": "Tribe A", "gilde": "CS", "coach": "Jouw Naam", "resultaat": "geslaagd"},
    {"separator": true},
    {"name": "Derde Student",     "start_date": null,         "semester": "5", "tribe": "Stage",   "gilde": "UX", "coach": "Jouw Naam"}
]
PORTFLOW_TRIBE_STUDENTS_JSON=[]
PORTFLOW_GILDE_STUDENTS_JSON=[
    {"name": "Vierde Student", "semester": "3", "tribe": "Tribe B", "gilde": "FE", "coach": "Collega Coach", "gildemeester": "Jouw Naam"}
]
